---
// Editorial heading-left / body-right row for case study narrative sections.
// Reused across the page wherever the spec calls for "heading/number in
// columns 1–3, body in columns 5–11" — currently only the Wedding App case
// study, but generic enough for a future second case study.
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="g cs rule soft">
  <h2 class="h3 cs-h">{heading}</h2>
  <div class="cs-body">
    <slot />
  </div>
</section>

<style>
  .cs {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    row-gap: var(--s-4);
  }

  @media (min-width: 1024px) {
    .cs-h {
      grid-column: 1 / 4;
    }

    .cs-body {
      grid-column: 5 / 12;
    }
  }
</style>
