---
import type { Role } from "../content/experience";

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<details class="role-row" open={role.current}>
  <summary class="g">
    <span class="when data">
      <b>{role.dateLabel}</b>
    </span>
    <span class="co">{role.company}</span>
    <span class="ttl">{role.title}</span>
    <span class="focus">{role.focus}</span>
    <span class="tog" aria-hidden="true"></span>
  </summary>
  <div class="g det">
    <div>
      <p>{role.summary}</p>
      <ul>
        {role.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    </div>
    <div class="stack">
      <p class="label">Stack</p>
      <p class="data">
        <b>{role.stack.primary.join(" · ")}</b>
        <br />
        {role.stack.secondary.join(" · ")}
      </p>
    </div>
  </div>
</details>

<style>
  .role-row {
    border-top: 1px solid var(--rule);
  }

  .role-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .role-row summary {
    list-style: none;
    cursor: pointer;
    padding-block: var(--s-5);
    align-items: baseline;
    row-gap: 6px;
  }

  .role-row summary::-webkit-details-marker {
    display: none;
  }

  .role-row .when {
    grid-column: 1 / 4;
    grid-row: 1;
  }

  .role-row .tog {
    grid-column: 4 / 5;
    grid-row: 1;
    justify-self: end;
    width: 24px;
    height: 24px;
    position: relative;
  }

  .role-row .tog::before,
  .role-row .tog::after {
    content: "";
    position: absolute;
    left: 5px;
    right: 5px;
    top: 50%;
    height: 1px;
    background: var(--ink);
    transition: transform var(--d-reveal) var(--ease);
  }

  .role-row .tog::after {
    transform: rotate(90deg);
  }

  .role-row[open] .tog::after {
    transform: rotate(0);
  }

  .role-row .co {
    grid-column: 1 / -1;
    grid-row: 2;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    transition: color var(--d-micro);
  }

  .role-row summary:hover .co {
    color: var(--signal);
  }

  .role-row .ttl {
    grid-column: 1 / -1;
    grid-row: 3;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .role-row .focus {
    display: none;
  }

  .role-row .det {
    padding-bottom: var(--s-7);
    row-gap: var(--s-5);
  }

  .role-row .det > div:first-child > p {
    font-size: var(--t-body);
    color: var(--ink);
    max-width: 60ch;
  }

  .role-row .det ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--s-4);
    color: var(--ink-2);
    font-size: var(--t-small);
  }

  .role-row .det li {
    display: grid;
    grid-template-columns: 20px 1fr;
    max-width: 62ch;
  }

  .role-row .det li::before {
    content: "—";
    color: var(--graphite);
  }

  .role-row .stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (min-width: 640px) {
    .role-row .when {
      grid-column: 1 / 3;
    }

    .role-row .co {
      grid-row: 1;
      grid-column: 3 / 7;
      font-size: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);
    }

    .role-row .tog {
      grid-column: 8 / 9;
    }

    .role-row .ttl {
      grid-row: 2;
      grid-column: 3 / 7;
    }

    .role-row .det > div:first-child {
      grid-column: 3 / 8;
    }

    .role-row .det .stack {
      grid-column: 3 / 8;
    }
  }

  @media (min-width: 1024px) {
    .role-row summary {
      grid-template-rows: auto;
    }

    .role-row .when {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .role-row .co {
      grid-column: 3 / 6;
      grid-row: 1;
    }

    .role-row .ttl {
      grid-column: 6 / 9;
      grid-row: 1;
      font-size: var(--t-body);
      color: var(--ink);
    }

    .role-row .focus {
      display: block;
      grid-column: 9 / 12;
      grid-row: 1;
      font-size: var(--t-small);
      color: var(--ink-2);
    }

    .role-row .tog {
      grid-column: 12 / 13;
      grid-row: 1;
    }

    .role-row .det > div:first-child {
      grid-column: 3 / 9;
    }

    .role-row .det .stack {
      grid-column: 9 / 12;
    }
  }
</style>
