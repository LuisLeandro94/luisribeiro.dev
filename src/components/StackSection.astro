---
import SectionHead from "./SectionHead.astro";
import { stackColumns } from "../content/stack";
---

<section class="sec" id="stack" aria-labelledby="stack-h">
  <div class="wrap">
    <SectionHead
      number="03"
      label="Stack"
      id="stack-h"
      title="What I use, and where I used it."
      intro="Split by context, because shipping Blazor to a production finance platform and using Next.js on a personal project are different kinds of experience."
    />
    <div class="g cols sec-body">
      {stackColumns.map((col) => (
        <div class="rule">
          <p class="label">{col.key}</p>
          <h3 class="h3">{col.title}</h3>
          <p class="sub">{col.subtitle}</p>
          <ul class="tech">
            {col.items.map((item) => (
              <li>
                <span>{item.name}</span>
                {item.context && <span class="data">{item.context}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cols {
    row-gap: var(--s-7);
  }

  .cols > :global(div) {
    padding-top: var(--s-3);
  }

  .cols .h3 {
    margin-top: var(--s-4);
    font-size: 1.25rem;
  }

  .cols .sub {
    color: var(--graphite);
    font-size: var(--t-small);
    margin-top: 4px;
  }

  .tech {
    margin-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .tech li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-small);
    align-items: baseline;
  }

  .tech li span:first-child {
    font-weight: 500;
  }

  .tech li span.data {
    text-align: right;
  }

  @media (min-width: 640px) {
    .cols > :global(div:nth-child(1)) {
      grid-column: 1 / 5;
    }

    .cols > :global(div:nth-child(2)) {
      grid-column: 5 / 9;
    }

    .cols > :global(div:nth-child(3)) {
      grid-column: 1 / 9;
    }
  }

  @media (min-width: 1024px) {
    .cols > :global(div:nth-child(1)) {
      grid-column: 1 / 5;
    }

    .cols > :global(div:nth-child(2)) {
      grid-column: 5 / 9;
    }

    .cols > :global(div:nth-child(3)) {
      grid-column: 9 / 13;
    }
  }
</style>
