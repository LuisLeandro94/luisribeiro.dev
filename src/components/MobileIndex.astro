---
import { site, navSections } from "../content/site";
---

<dialog class="idx" id="idx" aria-label="Site index">
  <div class="wrap">
    <div class="top">
      <span class="brand">
        <b>{site.name}</b>
        <span>Index</span>
      </span>
      <button class="btn-k" type="button" data-close-idx>
        Close
      </button>
    </div>
    <nav aria-label="Sections">
      {navSections.map((section) => (
        <a href={`#${section.id}`}>
          {section.label}
          <span>{section.number}</span>
        </a>
      ))}
    </nav>
    <div class="bot">
      <a class="lnk" href={site.cvHref} download data-cv>
        CV <span class="ar dn">↓</span>
      </a>
      <a class="lnk" href={site.linkedin.url} target="_blank" rel="noopener">
        LinkedIn <span class="ar">↗</span>
      </a>
      <a class="lnk" href={site.github.url} target="_blank" rel="noopener">
        GitHub <span class="ar">↗</span>
      </a>
    </div>
  </div>
</dialog>

<style>
  .idx {
    width: 100%;
    height: 100%;
    margin: 0;
    background: var(--paper);
    border: 0;
    padding: 0;
    max-width: none;
    max-height: none;
    color: var(--ink);
  }

  .idx[open] {
    display: flex;
    flex-direction: column;
  }

  .idx .wrap {
    width: 100%;
  }

  .idx .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--ink);
    margin-top: env(safe-area-inset-top, 0px);
  }

  .idx .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .idx .brand span {
    font: 400 0.7rem var(--f-mono);
    color: var(--graphite);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .idx nav {
    display: flex;
    flex-direction: column;
    margin-top: var(--s-5);
  }

  .idx nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    min-height: 56px;
  }

  .idx nav a span {
    font: 500 var(--t-label) var(--f-mono);
    color: var(--graphite);
  }

  .idx .bot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: var(--s-6);
    font-size: var(--t-small);
  }
</style>
