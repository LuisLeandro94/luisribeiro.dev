---
// Native <dialog> command palette. Behavior lives in scripts/command-menu.ts;
// this template only provides the accessible combobox/listbox structure.
---

<dialog class="cmd" id="cmd" aria-label="Command menu">
  <input
    id="cmdq"
    type="text"
    placeholder="Jump to a section or run an action"
    role="combobox"
    aria-expanded="true"
    aria-controls="cmdlist"
    aria-autocomplete="list"
    autocomplete="off"
    spellcheck="false"
  />
  <ul id="cmdlist" role="listbox" aria-label="Commands"></ul>
  <div class="foot-k data">
    <span>↑↓ move</span>
    <span>↵ select</span>
    <span>esc close</span>
  </div>
</dialog>

<style>
  dialog {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink);
    max-width: none;
    max-height: none;
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    backdrop-filter: blur(3px);
  }

  .cmd {
    width: min(560px, calc(100vw - 32px));
    margin: min(16vh, 140px) auto auto;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
  }

  .cmd input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: 400 1.0625rem var(--f-sans);
    padding: 16px 18px;
    outline: none;
  }

  .cmd input::placeholder {
    color: var(--graphite);
  }

  .cmd ul {
    max-height: min(52vh, 420px);
    overflow: auto;
    padding: 6px 0;
  }

  .cmd :global(.grp) {
    padding: 10px 18px 4px;
  }

  .cmd li[role="option"] {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    cursor: pointer;
    font-size: var(--t-small);
  }

  .cmd li[role="option"][aria-selected="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .cmd li[role="option"][aria-selected="true"] :global(.data) {
    color: var(--paper);
    opacity: 0.7;
  }

  .cmd .empty {
    padding: 18px;
    color: var(--graphite);
    font-size: var(--t-small);
  }

  .cmd .foot-k {
    display: flex;
    gap: 16px;
    padding: 9px 18px;
    border-top: 1px solid var(--rule);
  }
</style>
